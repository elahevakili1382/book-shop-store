# MongoDB Atlas connection string
MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/bookstore?retryWrites=true&w=majority

# یا
# MONGODB_URI=...

# JWT برای لاگین (در پروداکشن یک رشته تصادفی قوی بگذار)
JWT_SECRET=change-me-to-a-long-random-secret

# ادمین لوکال برای دیدن /dashboard (فقط development)
ADMIN_EMAIL=admin@booklett.ir
ADMIN_PASSWORD=BooklettAdmin123
